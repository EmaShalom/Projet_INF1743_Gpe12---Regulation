# ──────────────────────────────────────────────────────────────────
# frontend/.env.example — Variables d'environnement Vite
# Copier ce fichier : cp .env.example .env
# NE JAMAIS committer .env
#
# ⚠️  Vite n'expose que les variables préfixées VITE_
# ──────────────────────────────────────────────────────────────────

# URL de l'API backend (doit correspondre au PORT dans backend/.env)
VITE_API_URL=http://localhost:3001/api
