{
  "name": "uqo-requests-backend",
  "version": "1.0.0",
  "description": "API REST du projet UQO-Requests — INF1743",
  "main": "server.js",
  "scripts": {
    "start":   "node server.js",
    "dev":     "nodemon server.js",
    "migrate": "node src/migrations/run.js",
    "seed":    "node src/migrations/seed.js",
    "test":    "jest --coverage --verbose"
  },
  "dependencies": {
    "bcrypt":            "^5.1.1",
    "cors":              "^2.8.5",
    "dotenv":            "^16.4.5",
    "express":           "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken":      "^9.0.2",
    "pg":                "^8.11.5",
    "pg-hstore":         "^2.3.4",
    "sequelize":         "^6.37.3"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "nodemon":   "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
