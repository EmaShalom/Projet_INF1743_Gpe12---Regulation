# ──────────────────────────────────────────────────────────────────
# backend/.env.example — Variables d'environnement du serveur
# Copier ce fichier : cp .env.example .env
# NE JAMAIS committer .env (il est dans .gitignore)
# ──────────────────────────────────────────────────────────────────

# ── Serveur ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Base de données PostgreSQL ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uqo_requests_db
DB_USER=postgres
DB_PASSWORD=0000

# ── JWT ────────────────────────────────────────────────────────────
# ⚠️  Changer OBLIGATOIREMENT ce secret en production !
# Générer un secret sécurisé : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_cette_cle_min_32_chars_obligatoire_jamais_en_production
JWT_EXPIRES_IN=24h

# ── CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
